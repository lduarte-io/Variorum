ch_fts (search_fts, rowid, body)\n    SELECT \'delete\', id, OLD.working_text FROM search_doc WHERE kind = \'take\' AND src_id = OLD.id;\n  DELETE FROM search_doc WHERE kind = \'take\' AND src_id = OLD.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "search_fts_docsize", tbl_name: Optional("search_fts_docsize"), sql: Optional("CREATE TABLE \'search_fts_docsize\'(id INTEGER PRIMARY KEY, sz BLOB)")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "uq_canvas_layout_live", tbl_name: Optional("canvas_layout"), sql: Optional("CREATE UNIQUE INDEX uq_canvas_layout_live ON canvas_layout(container_id, block_id) WHERE deleted_at IS NULL")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "sqlite_autoindex_reference_1", tbl_name: Optional("reference"), sql: nil), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "sqlite_autoindex_tag_1", tbl_name: Optional("tag"), sql: nil), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "search_fts_config", tbl_name: Optional("search_fts_config"), sql: Optional("CREATE TABLE \'search_fts_config\'(k PRIMARY KEY, v) WITHOUT ROWID")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "sqlite_autoindex_mcp_setup_key_1", tbl_name: Optional("mcp_setup_key"), sql: nil), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_commit_point_insert", tbl_name: Optional("commit_point"), sql: Optional("CREATE TRIGGER outbox_commit_point_insert\nAFTER INSERT ON commit_point\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'commit_point\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "block_comment", tbl_name: Optional("block_comment"), sql: Optional("CREATE TABLE block_comment (\n  id           TEXT PRIMARY