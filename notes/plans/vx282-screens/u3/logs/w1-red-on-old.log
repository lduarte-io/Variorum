ved;\n  INSERT INTO search_fts (rowid, body)\n    SELECT id, NEW.working_text FROM search_doc WHERE kind = \'take\' AND src_id = NEW.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "uq_cblock_ownership", tbl_name: Optional("container_block"), sql: Optional("CREATE UNIQUE INDEX uq_cblock_ownership ON container_block(block_id) WHERE deleted_at IS NULL")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "mcp_activity", tbl_name: Optional("mcp_activity"), sql: Optional("CREATE TABLE mcp_activity (\n  id           INTEGER PRIMARY KEY,\n  client_name  TEXT NOT NULL,\n  act          TEXT NOT NULL,\n  target_kind  TEXT,\n  target_id    TEXT,\n  target_title TEXT,\n  outcome      TEXT NOT NULL CHECK (outcome IN (\'allowed\',\'refused\')),\n  at           TEXT NOT NULL\n)")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "search_variant_take_label_update", tbl_name: Optional("variant"), sql: Optional("CREATE TRIGGER search_variant_take_label_update\nAFTER UPDATE OF label, deleted_at, block_id, status ON variant\nWHEN OLD.label IS NOT NEW.label OR OLD.deleted_at IS NOT NEW.deleted_at OR OLD.block_id IS NOT NEW.block_id OR OLD.status IS NOT NEW.status\nBEGIN\n  INSERT INTO search_fts (search_fts, rowid, body)\n    SELECT \'delete\', id, OLD.label FROM search_doc WHERE kind = \'take_label\' AND src_id = OLD.id;\n  DELETE FROM search_doc\n    WHERE kind = \'take_label\' AND src_id = OLD.id AND NOT (NEW.deleted_at IS NULL AND NEW.label IS NOT NULL);\n  INSERT INTO search_doc (kind, src_id, block_id, archived)\n    SELECT \'take_label\', NEW.id, NEW.block_id, (NEW.status = \'archived\') WHERE NEW.deleted_at IS NULL AND NEW.label IS NOT NULL\n    ON CONFLICT (kind, src_id) DO UPDATE SET block_id = excluded.block_id, archived = excluded.archived;\n  INSERT INTO search_fts (rowid, body)\n    SELECT id, NEW.label FROM search_doc WHERE kind = \'take_label\' AND src_id = NEW.id;\nEND")), GRDB.SchemaO