ant_id)\n    SELECT \'savepoint\', NEW.id, NEW.variant_id WHERE NEW.text IS NOT NULL\n    ON CONFLICT (kind, src_id) DO UPDATE SET variant_id = excluded.variant_id;\n  INSERT INTO search_fts (rowid, body)\n    SELECT id, NEW.text FROM search_doc WHERE kind = \'savepoint\' AND src_id = NEW.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_block_insert", tbl_name: Optional("block"), sql: Optional("CREATE TRIGGER outbox_block_insert\nAFTER INSERT ON block\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'block\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_block_comment_insert", tbl_name: Optional("block_comment"), sql: Optional("CREATE TRIGGER outbox_block_comment_insert\nAFTER INSERT ON block_comment\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'block_comment\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_container_block_update", tbl_name: Optional("container_block"), sql: Optional("CREATE TRIGGER outbox_container_block_update\nAFTER UPDATE ON container_block\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'container_block\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "sqlite_autoindex_mcp_client_1", tbl_name: Optional("mcp_client"), sql: nil), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "sqlite_autoindex_grdb_migrations_1", tbl_name: Optional("grdb_migrations"), sql: nil), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "uq_