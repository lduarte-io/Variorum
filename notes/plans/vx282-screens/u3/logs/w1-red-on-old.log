ERE kind = \'savepoint\' AND src_id = NEW.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "sqlite_autoindex_mcp_grant_1", tbl_name: Optional("mcp_grant"), sql: nil), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "edge", tbl_name: Optional("edge"), sql: Optional("CREATE TABLE edge (\n  id              TEXT PRIMARY KEY,\n  source_block_id TEXT NOT NULL,\n  target_block_id TEXT NOT NULL,\n  type            TEXT NOT NULL CHECK (type IN (\'derived_from\',\'version_of\')),\n  origin_op       TEXT,\n  created_at      TEXT NOT NULL,\n  deleted_at      TEXT,\n  sync_version    INTEGER NOT NULL DEFAULT 0,\n  FOREIGN KEY (source_block_id) REFERENCES block(id),\n  FOREIGN KEY (target_block_id) REFERENCES block(id)\n)")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_lens_choice_insert", tbl_name: Optional("lens_choice"), sql: Optional("CREATE TRIGGER outbox_lens_choice_insert\nAFTER INSERT ON lens_choice\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'lens_choice\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "idx_variant_block", tbl_name: Optional("variant"), sql: Optional("CREATE INDEX idx_variant_block  ON variant(block_id, status)")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_wing_insert", tbl_name: Optional("wing"), sql: Optional("CREATE TRIGGER outbox_wing_insert\nAFTER INSERT ON wing\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'wing\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "search_container_title_insert", tbl_name: Optional("container"), sql: Optional("CREATE TRIGGER search_container_title_insert\nAFTER INSERT ON container\nWHEN NEW.deleted_at IS NULL AND NEW.title IS NOT NULL\nBEGIN\n  DELETE FROM search_doc WHERE kind = \'title\' AND src_id = NEW.id;\n  INSERT INTO search_doc (kind, src_id, container_id, wing_id, archived)\n    SELECT \'title\', NEW.id, NEW.id, NEW.wing_id, (NEW.archived_at IS NOT NULL) WHERE NEW.deleted_at IS NULL AND NEW.title IS NOT NULL\n    ON CONFLICT (kind, src_id) DO UPDATE SET container_id = excluded.container_id, wing_id = excluded.wing_id, archived = excluded.archived;\n  INSERT INTO search_fts (rowid, body)\n    SELECT id, NEW.title FROM search_doc WHERE kind = \'title\' AND src_id = NEW.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "idx_container_undated_created", tbl_name: Optional("container"), sql: Optional("CREATE INDEX idx_container_undated_created ON container(created_at)\n  WHERE deleted_at IS NULL AND (entry_date IS NULL OR entry_date = \'\')")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_shelf_insert", tbl_name: Optional("shelf"), sql: Optional("CREATE TRIGGER outbox_shelf_insert\nAFTER INSERT ON shelf\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'shelf\', NEW.id, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "outbox_setting_insert", tbl_name: Optional("setting"), sql: Optional("CREATE TRIGGER outbox_setting_insert\nAFTER INSERT ON setting\nWHEN NOT EXISTS (SELECT 1 FROM _sync_applying)\nBEGIN\n  INSERT OR REPLACE INTO sync_outbox (table_name, row_id, queued_at)\n  VALUES (\'setting\', NEW.key, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'));\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "mcp_switch", tbl_name: Optional("mcp_switch"), sql: Optional("CREATE TABLE mcp_switch (\n  key        TEXT PRIMARY KEY,\n  value   