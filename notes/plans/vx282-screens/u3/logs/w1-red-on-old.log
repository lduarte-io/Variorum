owid, body)\n    SELECT id, NEW.name FROM search_doc WHERE kind = \'chapter\' AND src_id = NEW.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "idx_edge_source", tbl_name: Optional("edge"), sql: Optional("CREATE INDEX idx_edge_source ON edge(source_block_id, type)")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "cascade_block_tombstone", tbl_name: Optional("block"), sql: Optional("CREATE TRIGGER cascade_block_tombstone\nAFTER UPDATE OF deleted_at ON block\nWHEN OLD.deleted_at IS NULL AND NEW.deleted_at IS NOT NULL\nBEGIN\n  UPDATE variant SET deleted_at = NEW.deleted_at\n    WHERE block_id = NEW.id AND deleted_at IS NULL;\n  UPDATE container_block SET deleted_at = NEW.deleted_at\n    WHERE block_id = NEW.id AND deleted_at IS NULL;\n  UPDATE edge SET deleted_at = NEW.deleted_at\n    WHERE (source_block_id = NEW.id OR target_block_id = NEW.id) AND deleted_at IS NULL;\n  UPDATE block_tag SET deleted_at = NEW.deleted_at\n    WHERE block_id = NEW.id AND deleted_at IS NULL;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "trigger"), name: "search_block_block_name_delete", tbl_name: Optional("block"), sql: Optional("CREATE TRIGGER search_block_block_name_delete\nAFTER DELETE ON block\nBEGIN\n  INSERT INTO search_fts (search_fts, rowid, body)\n    SELECT \'delete\', id, OLD.name FROM search_doc WHERE kind = \'block_name\' AND src_id = OLD.id;\n  DELETE FROM search_doc WHERE kind = \'block_name\' AND src_id = OLD.id;\nEND")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "index"), name: "idx_container_major_rev", tbl_name: Optional("container"), sql: Optional("CREATE INDEX idx_container_major_rev  ON container(last_major_revision_at, id) WHERE deleted_at IS NULL")), GRDB.SchemaObject(type: GRDB.SchemaObjectType(rawValue: "table"), name: "reading_section", tbl_name: Optional("reading_section"), sql: Optional("CREATE TABLE reading_section (\n  id           TEXT PRIMARY KEY,\n  reading