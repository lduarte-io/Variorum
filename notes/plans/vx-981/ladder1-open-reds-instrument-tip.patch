diff --git a/Tests/VariorumMCPTests/VX981Probe.swift b/Tests/VariorumMCPTests/VX981Probe.swift
new file mode 100644
index 000000000..5e5e5d861
--- /dev/null
+++ b/Tests/VariorumMCPTests/VX981Probe.swift
@@ -0,0 +1,92 @@
+import Darwin
+import Foundation
+
+// INSTRUMENT ONLY (VX-981 ladder round 1 — the two open reds). Never shipped:
+// applied to the working tree for the soak, recorded as a patch under
+// notes/plans/vx-981/, then removed.
+
+/// A timeline of marks, relative to its creation, and a report line written to
+/// stderr and to `VX981_PROBE_LOG` (append) when set.
+final class VX981Timeline: @unchecked Sendable {
+    private let lock = NSLock()
+    private let start = ContinuousClock.now
+    private var marks: [String] = []
+    let tag: String
+
+    init(_ tag: String) { self.tag = tag }
+
+    func mark(_ label: String) {
+        let elapsed = ContinuousClock.now - start
+        let ms = Double(elapsed.components.seconds) * 1_000 + Double(elapsed.components.attoseconds) / 1e15
+        let text = "+\((ms * 10).rounded() / 10)ms \(label)"
+        lock.withLock { marks.append(text) }
+    }
+
+    func dump() -> String { lock.withLock { marks.joined(separator: " | ") } }
+
+    func report(_ outcome: String) {
+        var loads = [Double](repeating: 0, count: 3)
+        _ = getloadavg(&loads, 3)
+        let line = "VX981PROBE \(tag) \(outcome) :: load \(loads.map { Int($0) }) :: \(dump())\n"
+        FileHandle.standardError.write(Data(line.utf8))
+        if let path = ProcessInfo.processInfo.environment["VX981_PROBE_LOG"] {
+            if let handle = FileHandle(forWritingAtPath: path) {
+                handle.seekToEndOfFile()
+                handle.write(Data(line.utf8))
+                try? handle.close()
+            } else {
+                FileManager.default.createFile(atPath: path, contents: Data(line.utf8))
+            }
+        }
+    }
+}
+
+/// A whole-process `sample` (1 s) into `VX981_SAMPLE_DIR`, blocking the caller.
+func vx981Sample(_ tag: String) -> String {
+    guard let dir = ProcessInfo.processInfo.environment["VX981_SAMPLE_DIR"] else { return "no-sample-dir" }
+    let path = "\(dir)/sample-\(tag)-\(getpid())-\(Int(Date().timeIntervalSince1970)).txt"
+    let process = Process()
+    process.executableURL = URL(fileURLWithPath: "/usr/bin/sample")
+    process.arguments = ["\(getpid())", "1", "-mayDie", "-file", path]
+    process.standardOutput = FileHandle.nullDevice
+    process.standardError = FileHandle.nullDevice
+    do { try process.run() } catch { return "sample-failed: \(error)" }
+    process.waitUntilExit()
+    return path
+}
+
+/// Bytes a descriptor holds unread right now (`FIONREAD`); -1 on error.
+func vx981Unread(_ fd: Int32) -> Int32 {
+    var count: Int32 = 0
+    let fionread = UInt(0x4004_667F)  // _IOR('f', 127, int)
+    let result = withUnsafeMutablePointer(to: &count) { ioctl(fd, fionread, $0) }
+    return result == 0 ? count : -1
+}
+
+/// What `RawSocket.isHungUp` would have said, plus everything read after it:
+/// reads until EOF, an error (the receive timeout) or 1 MiB. `firstWasEOF` is
+/// exactly `isHungUp()`'s verdict.
+struct VX981Drain: Sendable {
+    let firstWasEOF: Bool
+    let bytes: Data
+    let ending: String
+
+    var text: String { String(decoding: bytes, as: UTF8.self) }
+
+    static func read(_ fd: Int32, timeline: VX981Timeline) -> VX981Drain {
+        var collected = Data()
+        var first: Int? = nil
+        var ending = "cap"
+        var buffer = [UInt8](repeating: 0, count: 65_536)
+        while collected.count < (1 << 20) {
+            let count = Darwin.read(fd, &buffer, buffer.count)
+            if first == nil { first = count; timeline.mark("drain first read=\(count) errno=\(count < 0 ? errno : 0)") }
+            if count == 0 { ending = "EOF"; break }
+            if count < 0 { ending = "read -1 errno \(errno)"; break }
+            collected.append(contentsOf: buffer[0..<count])
+            timeline.mark("drain +\(count) bytes")
+        }
+        timeline.mark("drain ended: \(ending)")
+        return VX981Drain(firstWasEOF: first == 0, bytes: collected, ending: ending)
+    }
+}
