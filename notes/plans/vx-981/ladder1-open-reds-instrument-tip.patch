+// INSTRUMENT ONLY (VX-981 ladder round 1). The TIP's version: the batch-3 seams
+// (`gateEventProbe`, `namingProbe`) exist here. The pre-batch-3 tree's copy of
+// this file is an empty `arm`.
+@testable import VariorumMCP
+
+enum VX981TipProbes {
+    static func arm(_ h: ServerHarness, _ timeline: VX981Timeline) {
+        h.host.gateEventProbe = { _, event in timeline.mark("gate \(event)") }
+        h.host.namingProbe = { _ in timeline.mark("initialize hook ran (named)") }
+    }
+}
