#!/usr/bin/env python3
"""vx — the Linear bridge (ruled 2026-10-06; notes/plans/workflow-transition-2026-10-06.md).

Linear holds status; the repo holds truth. This tool keeps the repo's read-cheap mirror:

  vx sync    Rewrite notes/TICKETS.md from Linear — open VX issues, grouped by project.
             Best-effort at bout start: no key / no network prints a notice and leaves
             the existing snapshot untouched (it carries its own generation stamp).
  vx key     How to store the API key.

The key is a Linear PERSONAL API KEY, read from (first match wins):
  1. the login Keychain item 'variorum-linear'
       security add-generic-password -s variorum-linear -a "$USER" -w
     (needs a real GUI session — over ssh the Keychain refuses with
      "User interaction is not allowed")
  2. ~/.variorum/linear.key  (chmod 600; the ssh-friendly road:
       mkdir -p ~/.variorum && cat > ~/.variorum/linear.key   # paste, Enter, Ctrl-D
       chmod 600 ~/.variorum/linear.key)
"""

import json
import subprocess
import sys
import urllib.request
from datetime import datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SNAPSHOT = REPO_ROOT / "notes" / "TICKETS.md"
API = "https://api.linear.app/graphql"

QUERY = """
query Open($after: String) {
  issues(
    first: 100
    after: $after
    filter: { state: { type: { nin: ["completed", "canceled"] } } }
  ) {
    pageInfo { hasNextPage endCursor }
    nodes {
      identifier title url updatedAt
      state { name type }
      project { name }
      labels { nodes { name } }
    }
  }
}
"""

STATE_ORDER = {"started": 0, "unstarted": 1, "triage": 2, "backlog": 3}


def keychain_key():
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", "variorum-linear", "-w"],
            capture_output=True, text=True, check=True,
        )
        key = out.stdout.strip()
        if key:
            return key
    except subprocess.CalledProcessError:
        pass
    key_file = Path.home() / ".variorum" / "linear.key"
    try:
        key = key_file.read_text().strip()
        return key or None
    except OSError:
        return None


def fetch_open_issues(key):
    issues, after = [], None
    while True:
        body = json.dumps({"query": QUERY, "variables": {"after": after}}).encode()
        req = urllib.request.Request(
            API, data=body,
            headers={"Content-Type": "application/json", "Authorization": key},
        )
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read())
        if "errors" in data:
            raise RuntimeError(f"Linear GraphQL error: {data['errors']}")
        page = data["data"]["issues"]
        issues.extend(page["nodes"])
        if not page["pageInfo"]["hasNextPage"]:
            return issues
        after = page["pageInfo"]["endCursor"]


def render(issues):
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    lines = [
        "# TICKETS — the Linear snapshot",
        "",
        f"> GENERATED by `Tools/vx sync` {stamp} — NEVER edit by hand; edit Linear.",
        "> Open issues only (completed/canceled excluded). Linear is truth for STATUS;",
        "> the repo is truth for DESIGN (CLAUDE.md, the 2026-10-06 workflow transition).",
        "",
    ]

    def row(i):
        labels = ", ".join(l["name"] for l in i["labels"]["nodes"])
        label_part = f"  `{labels}`" if labels else ""
        return f"- **{i['identifier']}** [{i['state']['name']}] {i['title']}{label_part}"

    needs = [i for i in issues if i["state"]["name"].lower() == "needs lillian"]
    if needs:
        lines += ["## Needs Lillian", ""]
        lines += [row(i) for i in needs]
        lines += [""]

    by_project = {}
    for i in issues:
        name = (i["project"] or {}).get("name") or "No project"
        by_project.setdefault(name, []).append(i)
    for name in sorted(by_project, key=lambda n: (n == "No project", n.lower())):
        group = sorted(
            by_project[name],
            key=lambda i: (STATE_ORDER.get(i["state"]["type"], 9), i["identifier"]),
        )
        lines += [f"## {name}", ""]
        lines += [row(i) for i in group]
        lines += [""]

    lines += [f"*{len(issues)} open tickets.*", ""]
    return "\n".join(lines)


def sync():
    key = keychain_key()
    if not key:
        print("vx sync: no API key in the Keychain (item 'variorum-linear') — snapshot left as-is.")
        print("Store one with:  security add-generic-password -s variorum-linear -a \"$USER\" -w")
        return 0
    try:
        issues = fetch_open_issues(key)
    except Exception as e:  # network/auth: best-effort by design
        print(f"vx sync: Linear unreachable ({e}) — snapshot left as-is.")
        return 0
    SNAPSHOT.write_text(render(issues))
    print(f"vx sync: wrote {SNAPSHOT.relative_to(REPO_ROOT)} ({len(issues)} open tickets).")
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "sync"
    if cmd == "sync":
        return sync()
    if cmd == "key":
        print(__doc__)
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
