#!/usr/bin/env python3
"""verify-pins — does a resolved package state match the COMMITTED pins? (VX-781)

usage:
  Tools/verify-pins                      check the working tree's two lockfiles (the pre-build guard)
  Tools/verify-pins <state> [<state>...] check resolved states after a build or resolve
  options: --ref <git-rev>   compare against the lockfile committed at <rev> (default HEAD)
           --against <file>  compare against this Package.resolved instead of a commit
           --cli             the state is the CLI (repo-root package) graph, which never holds the
                             Xcode project's own references (Sparkle) — those are not expected

<state> is any of: a SourcePackages/workspace-state.json · a SourcePackages dir · a DerivedData dir
(…/SourcePackages/workspace-state.json is found inside) · a Package.resolved. A file is read by its
CONTENT, so renamed copies work. The reference is the Xcode workspace lockfile as COMMITTED (git,
never the working-tree copy, which a build can rewrite). Pins compare by identity, version and
revision. The originHash is ignored: the workspace's is a hash of the checkout's absolute path,
so it differs on every checkout. The no-argument form is VERSIONS-EQUAL too (VX-853, P-781-3): a
working-tree lockfile whose bytes differ from its own committed copy while its pins equal that
copy's exactly (only bookkeeping moved, e.g. the originHash) prints a NOTE and passes — harmless,
but restore it with git checkout -- before committing, never commit it. A missing lockfile, a pin
that differs from its own committed copy, or one that differs from the workspace set fails. The
project-only packages (`--cli`, and the root lockfile in the no-argument form) are
the Xcode project's references whose identity Package.swift never names, read AT the reference
revision (`--ref`, default HEAD), or from the working tree under `--against`.

exit: 0 every pin matches (a bookkeeping NOTE included) · 1 drift (each drifted pin named) ·
2 usage or unreadable input.
The release's post-build check: Tools/verify-pins "<OUT>/DerivedData"
The belt's static guard is Tests/VariorumCoreTests/PinBeltTests.swift; the networked proof is
Tools/pins-belt-check.
"""
import json
import os
import re
import subprocess
import sys

WS_LOCK = "App/Variorum/Variorum.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
ROOT_LOCK = "Package.resolved"
PBXPROJ = "App/Variorum/Variorum.xcodeproj/project.pbxproj"
MANIFEST = "Package.swift"


def die(msg):
    print(f"verify-pins: {msg}", file=sys.stderr)
    sys.exit(2)


def repo_root():
    here = os.path.dirname(os.path.realpath(__file__))
    try:
        return subprocess.check_output(["git", "-C", here, "rev-parse", "--show-toplevel"],
                                       text=True, stderr=subprocess.DEVNULL).strip()
    except (subprocess.CalledProcessError, OSError):
        die(f"not inside a git checkout: {here}")


def git_show(root, rev, path):
    try:
        return subprocess.check_output(["git", "-C", root, "show", f"{rev}:{path}"],
                                       text=True, stderr=subprocess.DEVNULL)
    except (subprocess.CalledProcessError, OSError):
        die(f"cannot read {rev}:{path}")


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def pins_of(data, where):
    """identity -> (version, revision), from a Package.resolved OR a workspace-state.json, by content."""
    try:
        if isinstance(data, dict) and "pins" in data:
            return {p["identity"]: (p["state"].get("version"), p["state"].get("revision"))
                    for p in data["pins"]}
        if isinstance(data, dict) and "dependencies" in data.get("object", {}):
            out = {}
            for dep in data["object"]["dependencies"]:
                ref, state = dep["packageRef"], dep.get("state", {})
                if ref.get("kind") != "remoteSourceControl":
                    continue  # the local package (fileSystem) and anything unpinnable
                cs = state.get("checkoutState", {})
                out[ref["identity"]] = (cs.get("version"), cs.get("revision") or state.get("name"))
            return out
    except (KeyError, TypeError, AttributeError):
        pass
    die(f"neither a Package.resolved nor a workspace-state.json: {where}")


def parse_json(text, where):
    try:
        return json.loads(text)
    except ValueError:
        die(f"not JSON: {where}")


def load_state(arg):
    p = os.path.abspath(arg)
    for cand in (p, os.path.join(p, "workspace-state.json"),
                 os.path.join(p, "SourcePackages", "workspace-state.json")):
        if os.path.isfile(cand):
            text = read_file(cand)
            if text is None:
                die(f"unreadable: {cand}")
            return cand, pins_of(parse_json(text, cand), cand)
    die(f"no workspace-state.json or Package.resolved at {arg}")


def identity(url):
    last = url.rstrip("/").split("/")[-1]
    return (last[:-4] if last.endswith(".git") else last).lower()


def project_only(pbx_text, manifest_text):
    """identities the Xcode project references but the root Package.swift never names (Sparkle)."""
    named = {identity(u) for u in re.findall(r'\.package\(\s*url:\s*"([^"]+)"', manifest_text)}
    return {identity(u) for u in re.findall(r'repositoryURL = "([^"]+)";', pbx_text)} - named


def short(v):
    version, rev = v
    return f"{version} ({(rev or '?')[:7]})"


def pin_diffs(got, want, skip=frozenset()):
    """the MISSING/EXTRA/DRIFT lines between a resolved and a committed pin set, by identity,
    version and revision; empty when every pin matches."""
    lines = []
    for ident in sorted(set(want) | set(got)):
        if ident in skip and ident not in got:
            continue
        if ident not in got:
            lines.append(f"  MISSING {ident}: committed {short(want[ident])}, not in the resolved state")
        elif ident not in want:
            lines.append(f"  EXTRA   {ident}: resolved {short(got[ident])}, not in the committed set")
        elif got[ident] != want[ident]:
            lines.append(f"  DRIFT   {ident}: committed {short(want[ident])} -> resolved {short(got[ident])}")
    return lines


def compare(label, got, want, skip=frozenset()):
    lines = pin_diffs(got, want, skip)
    if lines:
        print(f"DRIFT  {label}: {len(lines)} pin(s) differ from the committed set")
        print("\n".join(lines))
        return False
    print(f"OK     {label}: {len([i for i in want if i in got])} pins match the committed set")
    return True


def main(argv):
    ref, against, cli, states = "HEAD", None, False, []
    it = iter(argv)
    for a in it:
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--ref":
            ref = next(it, None) or die("--ref needs a git revision")
        elif a == "--against":
            against = next(it, None) or die("--against needs a file")
        elif a == "--cli":
            cli = True
        elif a.startswith("-"):
            die(f"unknown option {a} (see --help)")
        else:
            states.append(a)

    root = repo_root()
    if against:
        text = read_file(against)
        if text is None:
            die(f"unreadable: {against}")
        want = pins_of(parse_json(text, against), against)
        ref_label = against
        skip = project_only(read_file(os.path.join(root, PBXPROJ)) or "",
                            read_file(os.path.join(root, MANIFEST)) or "")
    else:
        want = pins_of(parse_json(git_show(root, ref, WS_LOCK), f"{ref}:{WS_LOCK}"), f"{ref}:{WS_LOCK}")
        ref_label = f"{ref}:{WS_LOCK}"
        skip = project_only(git_show(root, ref, PBXPROJ), git_show(root, ref, MANIFEST))
    print(f"verify-pins: reference = {ref_label} ({len(want)} pins)")

    ok = True
    if not states:
        # The pre-build guard: the working tree's lockfiles, as a build would read them.
        restore = "git checkout --" if ref == "HEAD" else f"git checkout {ref} --"
        for rel, label, skipping, absent in (
                (WS_LOCK, f"{WS_LOCK} (working tree)", frozenset(),
                 "a build would resolve WITHOUT pins"),
                (ROOT_LOCK, f"{ROOT_LOCK} (working tree, the CLI graph)", skip,
                 "swift build would resolve WITHOUT pins")):
            text = read_file(os.path.join(root, rel))
            if text is None:
                print(f"DRIFT  {rel}: MISSING from the working tree ({absent})")
                ok = False
                continue
            got = pins_of(parse_json(text, rel), rel)
            committed = None if against else git_show(root, ref, rel)
            if committed is not None and text != committed:
                # NOTE or DRIFT is decided against THIS file's own committed pins, exactly (no
                # project-only skip): the root lockfile is not the workspace one. compare() below
                # stays the cross-file check against the workspace set.
                own = pins_of(parse_json(committed, f"{ref}:{rel}"), f"{ref}:{rel}")
                if pin_diffs(got, own):
                    print(f"DRIFT  {rel}: the working-tree file differs from {ref} "
                          f"(a build ADOPTS it) — restore it with {restore} before building")
                    ok = False
                else:
                    # VERSIONS-EQUAL (VX-853, P-781-3): every pin identical, so only bookkeeping
                    # moved (the workspace originHash hashes the checkout's path, VX-781 record
                    # T-2) — harmless.
                    print(f"NOTE   {rel}: differs from {ref} only in bookkeeping (pins identical) — "
                          f"harmless; restore with {restore} before committing, never commit it.")
            ok &= compare(label, got, want, skipping)
    else:
        for s in states:
            path, got = load_state(s)
            ok &= compare(path, got, want, skip if cli else frozenset())
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
