# 36 (R2-4). A contributor's identity refuses, but the guard never tells a session to re-author it.
write_list; printf '%s\n' "$IDENT" >>"$LIST"
branch_from_main r24-contrib
printf 'c\n' >notes/contrib.md; git add notes/contrib.md
GIT_AUTHOR_NAME="Jane Contributor" GIT_AUTHOR_EMAIL="jane@example.org" git commit -q -m "a contributor's commit"
push -u origin r24-contrib
expect_refuse "a contributor's identity refuses without re-author advice (R2-4)" "--reset-author" "[public-identity]" "is not this clone's own"

# 37 (R2-6). A 0x1f in an author name cannot shift the identity fields.
