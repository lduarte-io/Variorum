printf 's\n' >notes/sep.md; git add notes/sep.md
GIT_AUTHOR_NAME="$(printf 'Ann\037Lee')" GIT_AUTHOR_EMAIL="ann@users.noreply.github.com" \
  GIT_COMMITTER_EMAIL="me@personal.example" git commit -q -m "a clean message"
push -u origin r26-sep
expect_refuse "a 0x1f in an author name cannot shift the identity fields (R2-6)" - "committer identity" "[public-identity]"
write_list

# 38 (R2-6). A control byte in a path never reaches the terminal raw.
branch_from_main r26-esc
esc_path="$(printf 'esc\033[31m.txt')"; printf 'v %s\n' "$SAMPLE" >"$esc_path"; git add -- "$esc_path"
git commit -q -m "a control byte in a path"
push -u origin r26-esc
expect_refuse "a control byte in a path never reaches the terminal raw (R2-6)" "$(printf '\033')" "[test-token]"

# 39 (R2-5). A ref naming a blob refuses; every tag in a tag-of-tag chain is scanned.
blob="$(printf 'blob body %s\n' "$SAMPLE" | git hash-object -w --stdin)"
git tag r25-blobtag "$blob"
push origin r25-blobtag; expect_refuse "a ref naming a blob refuses (R2-5)" "$SAMPLE" "not a commit"
git tag -d r25-blobtag >/dev/null
git tag -a r25-inner -m "inner message $SAMPLE" origin/main
git tag -a r25-outer -m "outer message" r25-inner 2>/dev/null
git tag -d r25-inner >/dev/null
push origin r25-outer; expect_refuse "every tag in a tag-of-tag chain is scanned (R2-5)" "$SAMPLE" "tag message" "[test-token]"
git tag -d r25-outer >/dev/null

