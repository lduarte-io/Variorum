#!/bin/bash
# test-githooks — the pre-push guard's self-contained proof (VX-996). No Xcode, no stage, no network.
#
#   Tools/test-githooks
#
# Builds a throwaway remote and clone in a temp dir with an isolated HOME and git config, installs
# the guard from THIS checkout's Tools/githooks through Tools/install-githooks, and pushes through it:
# clean pushes pass; a private token in an added line, a commit message, an identity, a new file's
# path or a ref name refuses; a new branch is scanned but never what the remote already holds; a
# merge's own lines are scanned; a missing or malformed list refuses; a matched value is never
# printed. Exit 0 = every case held.
set -uo pipefail

SRC="$(cd "$(dirname "$0")/.." && pwd)"
T="$(mktemp -d "${TMPDIR:-/tmp}/vx996-guard.XXXXXX")"
trap 'rm -rf "$T"' EXIT

# Isolation: nothing of the author's own git config, hooks or private list is read.
export HOME="$T/home"
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL="$T/gitconfig"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
mkdir -p "$HOME/.variorum"
git config --global user.name "Guard Test"
git config --global user.email "guard-test@users.noreply.github.com"
git config --global init.defaultBranch main
git config --global commit.gpgsign false
git config --global tag.gpgsign false
git config --global advice.detachedHead false

TOKEN="quokka-velvet-7731"          # the test list's literal (not a real value of anyone's)
REGEX_HIT="zx-4821-qq"              # matches the test list's regex
LIST="$HOME/.variorum/private-tokens.txt"
write_list() {
  cat >"$LIST" <<EOF
# the test list
test-token lit:$TOKEN
test-regex re:zx-[0-9]{4}-qq
keep test-token kept/*.txt
EOF
}
write_list

PASS=0; FAIL=0; FAILED=""
ok()  { PASS=$((PASS + 1)); printf '  ok    %s\n' "$1"; }
bad() { FAIL=$((FAIL + 1)); FAILED="$FAILED\n  - $1"; printf '  FAIL  %s — %s\n' "$1" "$2"; }

# push <args…>: runs git push from the current directory, capturing OUT and RC.
push() { OUT="$(git push "$@" 2>&1)"; RC=$?; }
expect_pass() {
  if [ "$RC" -eq 0 ]; then ok "$1"; else bad "$1" "the push was refused (rc=$RC): $(printf '%s' "$OUT" | grep -v '^error: failed to push' | tail -4 | tr '\n' ' ')"; fi
}
# expect_refuse <case> <value-that-must-not-print|-> <needle>…
expect_refuse() {
  local name="$1" value="$2"; shift 2
  if [ "$RC" -eq 0 ]; then bad "$name" "the push went through"; return; fi
  local n
  for n in "$@"; do
    case "$OUT" in *"$n"*) ;; *) bad "$name" "the refusal does not say: $n"; return ;; esac
  done
  if [ "$value" != "-" ] && printf '%s' "$OUT" | grep -qiF -- "$value"; then
    bad "$name" "the refusal printed the matched value"; return
  fi
  ok "$name"
}
commit_file() { # commit_file <path> <content> [message]
  mkdir -p "$(dirname "$1")"; printf '%s\n' "$2" >"$1"; git add -- "$1"
  git commit -q -m "${3:-add $1}"
}
branch_from_main() { git checkout -q -B "$1" origin/main; }

echo "test-githooks: building a throwaway remote and clone under $T"
git init -q --bare "$T/remote.git"
git clone -q "$T/remote.git" "$T/work" 2>/dev/null
cd "$T/work" || exit 1
mkdir -p Tools
cp -R "$SRC/Tools/githooks" Tools/githooks
cp "$SRC/Tools/install-githooks" Tools/install-githooks
commit_file README.md "a throwaway repo for the VX-996 guard's tests" "seed"
git add Tools && git commit -q -m "the guard"
git push -q origin main 2>/dev/null || { echo "could not seed the remote"; exit 1; }
git fetch -q origin

echo "test-githooks: installing"
inst="$(Tools/install-githooks 2>&1)"; irc=$?
[ "$irc" -eq 0 ] && ok "the installer runs" || bad "the installer runs" "$inst"
want="$(cd "$T/work" && pwd -P)/Tools/githooks"
got="$(git config --local --get core.hooksPath || true)"
[ "$(cd "$got" 2>/dev/null && pwd -P)" = "$want" ] && ok "core.hooksPath is the main worktree's Tools/githooks" \
  || bad "core.hooksPath is the main worktree's Tools/githooks" "got '$got'"
inst2="$(Tools/install-githooks 2>&1)"
case "$inst2" in *"already on"*) ok "the installer is idempotent" ;; *) bad "the installer is idempotent" "$inst2" ;; esac
Tools/install-githooks --check >/dev/null 2>&1 && ok "--check says the guard is on" || bad "--check says the guard is on" "exit non-zero"

echo "test-githooks: pushes"

# 1. A clean new branch passes.
branch_from_main clean-new
commit_file notes/clean.md "an ordinary line of notes"
push -u origin clean-new; expect_pass "a clean new-branch push passes"

# 2. A clean update push passes — the bout-start board snapshot's shape (main, one generated file).
git checkout -q main
commit_file notes/TICKETS.md "- **VX-1** [Todo] A ticket title" "board snapshot"
push origin main; expect_pass "a clean update push to main (the board-snapshot shape) passes"

# 3. A private token on an added line refuses, naming commit, path:line and class — never the value.
branch_from_main token-line
commit_file notes/clean2.md "first line"
push -u origin token-line; expect_pass "setup: token-line pushed clean"
printf 'one\ntwo\nthe value %s sits here\n' "$TOKEN" >notes/leak.md; git add notes/leak.md; git commit -q -m "a leaky note"
sha="$(git rev-parse --short=10 HEAD)"
push origin token-line; expect_refuse "a token on an added line refuses (update push)" "$TOKEN" "$sha" "notes/leak.md:3" "[test-token]"

# 4. A token in a commit message refuses.
branch_from_main token-message
commit_file notes/fine.md "nothing private here" "a message that mentions $TOKEN in passing"
push -u origin token-message; expect_refuse "a token in a commit message refuses" "$TOKEN" "commit message" "[test-token]"

# 5. A new branch is scanned (its commits are not on the remote).
branch_from_main token-new
commit_file notes/a.md "alpha"
commit_file notes/b.md "beta $TOKEN beta"
push -u origin token-new; expect_refuse "a new-branch push is scanned" "$TOKEN" "notes/b.md:1" "[test-token]"

# 6. ...but never what the remote already holds: a token published earlier (here by --no-verify,
#    the author's bypass) does not refuse a new branch built on it.
branch_from_main published
commit_file notes/old.md "an old $TOKEN line"
push --no-verify -u origin published; expect_pass "setup: --no-verify bypasses the guard (the author's call)"
git checkout -q -b built-on-published
commit_file notes/new.md "a clean line on top"
push -u origin built-on-published; expect_pass "a new branch scans only what the remote does not already hold"

# 7. A regex entry refuses.
branch_from_main regex-hit
commit_file src/code.txt "let x = \"$REGEX_HIT\""
push -u origin regex-hit; expect_refuse "a regex entry refuses" "$REGEX_HIT" "src/code.txt:1" "[test-regex]"

# 8. A keep line exempts its class inside the kept paths only.
branch_from_main kept
commit_file kept/config.txt "load-bearing $TOKEN"
push -u origin kept; expect_pass "a keep line exempts its class in the kept path"

# 9. A new file's PATH carrying a token refuses (paths publish too) — and the path prints masked.
branch_from_main token-path
commit_file "captures/shot-$TOKEN.txt" "a clean body"
push -u origin token-path; expect_refuse "a token in an added file's path refuses" "$TOKEN" "file path" "[test-token]"

# 10. A ref name carrying a token refuses.
branch_from_main "topic-$TOKEN"
commit_file notes/c.md "a clean line"
push -u origin "topic-$TOKEN"
hook_out="$(printf '%s\n' "$OUT" | grep -iv '^error: failed to push')"
if [ "$RC" -ne 0 ] && printf '%s' "$OUT" | grep -qF "[test-token]" && ! printf '%s' "$hook_out" | grep -qiF -- "$TOKEN"; then
  ok "a token in a pushed ref name refuses"
else
  bad "a token in a pushed ref name refuses" "rc=$RC"
fi

# 11. A token in the commit identity refuses (author and committer publish with the commit).
branch_from_main token-identity
mkdir -p notes; printf 'clean\n' >notes/id.md; git add notes/id.md
git -c user.email="$TOKEN@example.com" commit -q -m "a clean message"
push -u origin token-identity; expect_refuse "a token in the commit identity refuses" "$TOKEN" "author" "[test-token]"

# 12. A binary file never blocks.
branch_from_main binary
printf 'PNG\000\001\002 %s \000\377' "$TOKEN" >img.bin; git add img.bin; git commit -q -m "a binary"
push -u origin binary; expect_pass "a binary file never blocks"

# 13. A push from a second worktree runs the same guard.
git worktree add -q -b from-worktree "$T/wt" origin/main 2>/dev/null
( cd "$T/wt" && commit_file notes/wt.md "worktree line $TOKEN" && OUT="$(git push -u origin from-worktree 2>&1)"; echo "rc=$?"; printf '%s\n' "$OUT" ) >"$T/wt.out" 2>&1
RC=$(sed -n 's/^rc=//p' "$T/wt.out" | head -1); OUT="$(cat "$T/wt.out")"
expect_refuse "a push from another worktree is guarded" "$TOKEN" "notes/wt.md:1" "[test-token]"

# 14. A merge's own lines (beyond both parents) are scanned.
branch_from_main merge-side
commit_file notes/m.md "side line"
push -u origin merge-side; expect_pass "setup: merge-side pushed clean"
branch_from_main merge-main
commit_file notes/n.md "main line"
git merge -q --no-ff --no-commit merge-side >/dev/null 2>&1
printf 'side line\nan evil-merge line %s\n' "$TOKEN" >notes/m.md; git add notes/m.md
git commit -q -m "merge merge-side"
msha="$(git rev-parse --short=10 HEAD)"
push -u origin merge-main; expect_refuse "a merge's own added lines are scanned" "$TOKEN" "$msha" "notes/m.md:2" "[test-token]"

# 15. An annotated tag's message is scanned.
git checkout -q main
git tag -a "v0-test" -m "a tag message naming $TOKEN" >/dev/null
push origin v0-test; expect_refuse "an annotated tag's message is scanned" "$TOKEN" "tag message" "[test-token]"
git tag -d v0-test >/dev/null

# 16. A deletion publishes nothing and passes.
push origin --delete clean-new; expect_pass "a branch deletion passes"

# 17. gitleaks's generic rules refuse a secret in content and in a message.
if command -v gitleaks >/dev/null 2>&1 || [ -x /opt/homebrew/bin/gitleaks ] || [ -x /usr/local/bin/gitleaks ]; then
  PAT="ghp_$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 36)"
  branch_from_main gl-content
  commit_file deploy/env.sh "export GITHUB_TOKEN=$PAT"
  push -u origin gl-content; expect_refuse "gitleaks refuses a secret on an added line" "$PAT" "deploy/env.sh:1" "[gitleaks:"
  branch_from_main gl-message
  commit_file notes/d.md "clean" "rotate the token $PAT tonight"
  push -u origin gl-message; expect_refuse "gitleaks refuses a secret in a commit message" "$PAT" "commit message" "[gitleaks:"
  branch_from_main gl-absent
  commit_file notes/e.md "clean"
  OUT="$(VARIORUM_GUARD_TEST_NO_GITLEAKS=1 git push -u origin gl-absent 2>&1)"; RC=$?
  expect_refuse "a missing gitleaks refuses" - "gitleaks"
else
  bad "gitleaks cases" "gitleaks is not installed on this Mac — the guard refuses every push without it"
fi

# 18. A missing list refuses, saying how to create it.
branch_from_main no-list
commit_file notes/f.md "clean"
mv "$LIST" "$LIST.away"
push -u origin no-list; expect_refuse "a missing private list refuses" - "private-tokens.txt" "private-tokens.example"
mv "$LIST.away" "$LIST"

# 19. A malformed list refuses, naming the line and never printing it.
printf 'test-token lit:%s\nnot-a-valid-entry\n' "$TOKEN" >"$LIST"
push -u origin no-list; expect_refuse "a malformed list refuses, naming the line" "not-a-valid-entry" "line 2"
printf 'empty-match re:x*\n' >"$LIST"
push -u origin no-list; expect_refuse "a list regex that matches the empty string refuses" - "line 1"
write_list

# 20. A starter list passes clean pushes but says so.
{ printf '!starter\n'; cat "$LIST"; } >"$LIST.tmp" && mv "$LIST.tmp" "$LIST"
push -u origin no-list
if [ "$RC" -eq 0 ] && printf '%s' "$OUT" | grep -qi "starter"; then ok "a starter list passes clean pushes and says it is the starter"; else bad "a starter list passes clean pushes and says it is the starter" "rc=$RC"; fi
write_list

# 21. The shipped example list loads, and its own text never trips it.
cp "$SRC/Tools/githooks/private-tokens.example" "$LIST"
branch_from_main example-self
commit_file Tools/githooks/copy-of-example.txt "$(cat "$SRC/Tools/githooks/private-tokens.example")"
push -u origin example-self; expect_pass "the shipped example loads and does not match its own text"
write_list

echo
if [ "$FAIL" -eq 0 ]; then
  echo "test-githooks: ALL $PASS CASES HELD"
  exit 0
fi
printf "test-githooks: %d held, %d FAILED:%b\n" "$PASS" "$FAIL" "$FAILED"
exit 1
